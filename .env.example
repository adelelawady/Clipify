GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
# Copy this file to `.env` and fill in your own secret keys. DO NOT commit `.env`.
# Example values are placeholders only.

# Google / Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gpt-4o-mini

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Default provider: "gemini" or "openai"
AI_PROVIDER=gemini

# Optional runtime settings
GRADIO_SERVER_PORT=7860
